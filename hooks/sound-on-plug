#!/usr/bin/env bash
set -euo pipefail

event="${1:-}"
sound_file="$HOME/.config/omarchy/plugins/io.github.bass57.sound-on-plug/sounds/$event.wav"

case "$event" in
  plug|unplug|inject) ;;
  *)
    printf 'Usage: %s {plug|unplug|inject}\n' "${0##*/}" >&2
    exit 2
    ;;
esac

if [[ ! -r "$sound_file" ]]; then
  printf 'USB sound file is missing or unreadable: %s\n' "$sound_file" >&2
  exit 1
fi

exec /usr/bin/pw-play "$sound_file"
