#!/bin/bash

# Plays a distinct chime for device events.
# Usage: sound-on-plug <plug|unplug|inject>
# Installed by ./install.sh into ~/.config/omarchy/hooks/sound-on-plug

EVENT="${1:-plug}"
LOG_FILE="$HOME/.local/state/omarchy/sound-on-plug.log"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SOUNDS_DIR="$SCRIPT_DIR/../sounds"
if [[ ! -d "$SOUNDS_DIR" ]]; then
  SOUNDS_DIR="$(cd "$SCRIPT_DIR/.." && pwd)/sounds"
fi
mkdir -p "$(dirname "$LOG_FILE")"
echo "$(date '+%F %T'): hook triggered (event: $EVENT)" >> "$LOG_FILE"

pick_file() {
  local dir="$1" base="$2"
  for ext in wav oga mp3; do
    if [[ -f "$dir/$base.$ext" ]]; then echo "$dir/$base.$ext"; return 0; fi
  done
  return 1
}

play_file() {
  local file="$1"
  [[ -z "$file" ]] && return 1
  if command -v mpv >/dev/null 2>&1; then
    mpv --no-video --really-quiet --volume=60 --volume-max=100 "$file" >>"$LOG_FILE" 2>&1
  elif command -v pw-play >/dev/null 2>&1; then
    pw-play "$file" >>"$LOG_FILE" 2>&1
  elif command -v paplay >/dev/null 2>&1; then
    paplay "$file" >>"$LOG_FILE" 2>&1
  fi
}

case "$EVENT" in
  plug|add)
    f="$(pick_file "$SOUNDS_DIR" plug)" || f="/usr/share/sounds/freedesktop/stereo/complete.oga"
    play_file "$f"
    echo "$(date '+%F %T'): played (plug) $f" >> "$LOG_FILE"
    ;;
  unplug|remove)
    f="$(pick_file "$SOUNDS_DIR" unplug)" || f="/usr/share/sounds/freedesktop/stereo/dialog-error.oga"
    play_file "$f"
    echo "$(date '+%F %T'): played (unplug) $f" >> "$LOG_FILE"
    ;;
  inject|bind|unmount)
    f="$(pick_file "$SOUNDS_DIR" inject)" || f="/usr/share/sounds/freedesktop/stereo/audio-volume-change.oga"
    play_file "$f"
    echo "$(date '+%F %T'): played (inject) $f" >> "$LOG_FILE"
    ;;
  *)
    f="$(pick_file "$SOUNDS_DIR" plug)" || f="/usr/share/sounds/freedesktop/stereo/complete.oga"
    play_file "$f"
    echo "$(date '+%F %T'): played (unknown->plug) $f" >> "$LOG_FILE"
    ;;
esac